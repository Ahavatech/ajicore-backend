# ==================================================
# Stripe Billing / Subscription
# ==================================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx

# Stripe webhook secret from Stripe Dashboard > Developers > Webhooks.
# The app can boot without this, but webhook processing requires it.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# Currency code for subscription billing.
# Examples: usd, ngn, gbp
STRIPE_CURRENCY=usd

# Optional: keep the Stripe Product ID for dashboard/reference use.
# This is not used in place of the price ID.
STRIPE_SUBSCRIPTION_PRODUCT_ID=prod_xxxxxxxxxxxxxxxxx

# Optional: use an existing Stripe Price ID.
# If provided, this should be used instead of dynamically creating a price.
# This must be a Stripe Price ID that starts with price_.
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxxxxxxxxxxxxxxxx

# Subscription price in the smallest currency unit.
# Example: 19700 = $197.00 if STRIPE_CURRENCY=usd
# Example: 5000 = $50.00 if STRIPE_CURRENCY=usd
# Example: 500000 = ₦5,000 if STRIPE_CURRENCY=ngn
STRIPE_SUBSCRIPTION_PRICE_AMOUNT=5000

# Free trial duration before first charge.
STRIPE_SUBSCRIPTION_TRIAL_DAYS=21

# Product name shown in Stripe.
STRIPE_SUBSCRIPTION_PRODUCT_NAME=Ajicore Business Subscription


# ==================================================
# Mail / SMTP
# ==================================================
MAIL_PROVIDER=smtp

# Ask hosting/email provider for the correct SMTP host.
# Examples only:
# cPanel/private mail often uses mail.yourdomain.com
# Zoho uses smtp.zoho.com
# Google Workspace uses smtp.gmail.com
SMTP_HOST=mail.example.com

# Usually 587 for STARTTLS, 465 for SSL.
SMTP_PORT=587

# false for port 587, true for port 465.
SMTP_SECURE=false

SMTP_USER=support@myajicore.com
SMTP_PASS=your_smtp_or_app_password_here

MAIL_FROM_NAME=Ajicore Support
MAIL_FROM_EMAIL=support@myajicore.com


# ==================================================
# Password Reset OTP
# ==================================================
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_CODE_LENGTH=5
PASSWORD_RESET_ALLOW_EMAIL=true
PASSWORD_RESET_ALLOW_SMS=true


# ==================================================
# Frontend
# ==================================================
APP_FRONTEND_URL=http://localhost:3000
